# ========================================
# LOGIS-AI Backend Environment Setup
# ========================================
NODE_ENV=development
PORT=5000

# [MongoDB Database Configuration]
MONGODB_URI=mongodb://localhost:27017/logis-ai

# [Authentication]
# Replace string with secure 256bit token in production
JWT_SECRET=super_secret_dev_key_only
JWT_EXPIRES_IN=30d

# [MQTT / IoT Configuration]
MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=backend-ingestion-1

# [AI Services]
# AI_SERVICE_URL=http://localhost:8000
# MODEL_STORAGE_PATH=./models/

# [Security]
# Comma separated allowed origins for CORS. Omit for wildcard testing locally
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# [Application Logic]
DEMO_MODE=true # Required for safe 'npm run demo' reset execution
